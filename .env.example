# MySQL 8.x with TypeORM. Use an empty schema for a first-time migration.
DATABASE_URL="mysql://pace:pace@localhost:3306/pace"
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"
NODE_ENV=development
# Set BEFORE running npm run db:seed; use a unique password >= 12 characters.
PACE_ADMIN_EMAIL="ahmedaminemaarouf1@gmail.com"
PACE_ADMIN_PASSWORD="Admin@1234"
PACE_ADMIN_NAME="Hazinofan"
# >= 32 random bytes, e.g. output of openssl rand -hex 32
PACE_SESSION_SECRET="258c536b119486053622d13712391314b016a189c19d7d7f045c55f0ba4afe72"

# Docker Compose local-only MySQL credentials. Change these on shared machines.
MYSQL_ROOT_PASSWORD="replace-with-a-root-password"
MYSQL_PASSWORD="pace"

# Optional: NestJS Observe integration
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Optional TypeORM SQL logging (default false)
TYPEORM_LOGGING=false
